diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -535,6 +535,31 @@
 .endm
 #endif
 
+#if defined(SWEET)
+/*
+ * Call sweet_early_mark() from early assembly, printing a text line on the panel.
+ *
+ * A tipped-over coloured block only reports "got this far"; this reports the
+ * stage by number and name through the same console arm_init uses, so the boot
+ * produces one continuous log from the first kernel instruction to kprintf.
+ *
+ * Saves nothing on the stack: at these sites the stack exists (set up earlier in
+ * start_first_cpu) but its contents are not ours to rely on yet, so the macro
+ * only touches registers the callers have proven dead:
+ *   x0, x1  - call arguments, dead at every insertion point
+ *   x16/x17 - intra-procedure scratch, which cannot hold live values across a call
+ *   lr      - saved in x16 and restored, since callers return through it
+ */
+.macro SWEET_LOG_MARK stage, label
+	mov		x16, lr
+	mov		x0, #\stage
+	adrp	x1, \label@page
+	add		x1, x1, \label@pageoff
+	bl		EXT(sweet_early_mark)
+	mov		lr, x16
+.endm
+#endif
+
 /*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
@@ -805,6 +830,8 @@
  */
 common_start:
 
+	SWEET_LOG_MARK 21, Lsweet_log21
+
 #if HAS_NEX_PG
 	mov x19, lr
 	bl		EXT(set_nex_pg)
@@ -879,6 +906,7 @@
 	ic		iallu
 #endif
 
+	SWEET_LOG_MARK 22, Lsweet_log22
 #if defined(SWEET)
 	/* Complete local TLB/I-cache invalidation before enabling the MMU. */
 	dsb		sy
@@ -913,6 +941,7 @@
 	sub		x0, x0, x23
 1:
 	MSR_VBAR_EL1_X0
+	SWEET_LOG_MARK 23, Lsweet_log23
 
 #if HAS_APPLE_PAC
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
@@ -923,6 +952,8 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+	SWEET_LOG_MARK 24, Lsweet_log24
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -985,6 +1016,7 @@
 	mov	lr, x21
 #endif
 
+	SWEET_LOG_MARK 25, Lsweet_log25
 	// Return to arm_init()
 	ret
 
@@ -1047,4 +1079,26 @@
 
 //#include	"globals_asm.h"
 
