index 45a4464..f9f76a3 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1845,9 +1845,17 @@ sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
 	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
-	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
-	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
-	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	/*
+	 * With T1SZ=17 (4K granule, SWEET 0097) the kernel pmap root is an
+	 * L0 table, so descend L0 -> L1 -> L2 instead of assuming L1 is the
+	 * root.
+	 */
+	tt_entry_t l0 = cpu_tte[(va & ARM_TT_L0_INDEX_MASK) >> ARM_TT_L0_SHIFT];
+	assert((l0 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l1 = (tt_entry_t *)phystokv(l0 & ARM_TTE_TABLE_MASK);
+	tt_entry_t l1e = l1[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1e & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1e & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
 	*slot = (tt_entry_t)sweet_fb_pa | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
@@ -1990,8 +1998,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 * hold our bootstrap mappings for any possible slide */
 	size_t bytes_mapped = dynamic_memory_begin - gVirtBase;
 	size_t l1_entries = 1 + ((bytes_mapped + ARM_TT_L1_SIZE - 1) / ARM_TT_L1_SIZE);
-	/* 1 L1 each for V=P and KVA, plus 1 page for each L2 */
-	size_t pages_used = 2 * (l1_entries + 1);
+	/* 1 L1 each for V=P and KVA, plus 1 page for each L2, plus 1 KVA L0
+	 * root (T1SZ=17, 4K granule). */
+	size_t pages_used = 2 * (l1_entries + 1) + 1;
 	if (pages_used > BOOTSTRAP_TABLE_SIZE) {
 		panic("BOOTSTRAP_TABLE_SIZE too small for memory config");
 	}
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e01c124..73fedad 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -971,7 +971,15 @@
 #if __ARM64_PMAP_SUBPAGE_L1__
 #define T1SZ_BOOT 26ULL
 #else /* __ARM64_PMAP_SUBPAGE_L1__ */
-#define T1SZ_BOOT 25ULL
+/*
+ * SWEET (0097): the kernel's KVA lives in the 0xfffffe0000000000 region,
+ * mirroring the 16K Apple layout.  A 4K granule would otherwise default to
+ * T1SZ=25, whose TTBR1 window starts at 0xffffff8000000000 and leaves the
+ * whole KVA untranslatable (Address size fault on the first stack frame).
+ * T1SZ=17 widens TTBR1 to 128TB so KVA works, at the cost of a 4-level
+ * table (bootstrap start.s installs the extra L0 root for it).
+ */
+#define T1SZ_BOOT 17ULL
 #endif /*__ARM64_PMAP_SUBPAGE_L1__*/
 #endif /* __ARM_16K_PG__ */
 #endif /* defined(APPLE_ARM64_ARCH_FAMILY) */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
