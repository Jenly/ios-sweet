+	 * and KVA, so 9 total pages (BOOTSTRAP_TABLE_SIZE is 12 for headroom).
 	 */
 	mov		x1, x25
-	add		x3, x1, PGBYTES
-	mov		x2, x3
+	add		x3, x1, #(2 * PGBYTES)				// KVA L1 table = page 3
+	add		x2, x3, PGBYTES						// free pointer starts at page 4
 
 	/*
 	 * Setup the V=P bootstrap mapping
@@ -783,6 +782,21 @@ Lkernelcache_base_found:
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
+	/*
+	 * KVA TTBR1 root: with T1SZ=17 the root is an L0 table.  Wire
+	 * L0[VA[47:39]] of the kernel's KVA base to the KVA L1 table.
+	 */
+	mov		x9, x1
+	add		x9, x9, PGBYTES						/* KVA L0 table = page 2 */
+	mov		x10, #(ARM_TTE_BOOT_TABLE)
