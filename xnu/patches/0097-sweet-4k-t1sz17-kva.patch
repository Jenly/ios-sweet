 #else /* defined(ARM_LARGE_MEMORY) */
-#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 8)
+/*
+ * SWEET 4K with T1SZ=17 (0097): V=P L1 + KVA L0 + KVA L1 + up to 3xL2
+ * pages for each of V=P and KVA = 9 pages; keep 12 for slide headroom.
+ */
+#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 12)
