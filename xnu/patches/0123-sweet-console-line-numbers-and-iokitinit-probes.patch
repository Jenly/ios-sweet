+#if defined(SWEET)
+/*
+ * sweet 0123: stamp every rendered console line with a running number.
+ * The framebuffer console wraps back to the top of the screen instead of
+ * scrolling, and the IOKit matching thread interleaves its output with the
+ * bootstrap thread, so a photo of the panel cannot be put in order by layout
+ * alone.  A line carrying a number from an older sequence is also left over
+ * from a previous boot and must not be read as the newest output.
+ */
+static uint32_t sweet_console_line_no;
+
+static void
+sweet_console_line_prefix(char * str, int * pos)
+{
+	uint32_t n;
+	char     tmp[12];
+	char     pfx[16];
+	int      t = 0, i = 0, k;
+
+	n = ++sweet_console_line_no;
+	while (n > 0) {
+		tmp[t++] = (char)('0' + (n % 10));
+		n /= 10;
+	}
+	while (t < 6) {
+		tmp[t++] = '0';
+	}
+	while (t > 0) {
+		pfx[i++] = tmp[--t];
+	}
+	pfx[i++] = ':';
+	pfx[i++] = ' ';
+	for (k = 0; k < i && *pos < (SERIAL_CONS_BUF_SIZE - 1); k++) {
+		str[*pos] = pfx[k];
+		*pos += 1;
+	}
+	str[*pos] = '\0';
+}
+#endif /* SWEET */
