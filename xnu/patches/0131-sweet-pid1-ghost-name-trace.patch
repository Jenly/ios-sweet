+/* ---------------------------------------------------------------------------
+ * SWEET 0131: trace the ghost reply-port name (0xfb1ea -> index 4017) that
+ * 0130 caught in pid 1's failing host_info() message.
+ *
+ * 0130 established that only the reply port name is wrong: the destination
+ * (503 = the host port), the msgh_id (0xc8 = host_info) and the kernel-side MIG
+ * service all check out, and pid 1's name table holds only 6 names (indices
+ * 3/4/5) out of its initial 32 entries.  Three questions remain:
+ *
+ *   1. was 0xfb1ea ever issued to *any* space?  ipc_entry_claim() is the single
+ *      choke point for dynamically issued names: watch it, remember the highest
+ *      name index ever issued anywhere, and count exact hits on the ghost name;
+ *   2. did pid 1's name table ever grow beyond its initial 32 entries?  If not,
+ *      index 4017 could never have been addressable in that space at all;
+ *   3. what were the *real* arguments of the failing mach_port_mod_refs() /
+ *      mach_port_move_member() calls, instead of the polluted exception frame?
+ *
+ * The verdict line (0131 KEY) is printed last, so it survives in the console
+ * ring even if the dump overruns the ring.
+ * ------------------------------------------------------------------------ */
+
+#define SWEET_GHOST_NAME    0xfb1ea     /* reply_name seen in the 0130 dump */
+#define SWEET_BB0131_BIG    64          /* record issued names with index >= this */
+#define SWEET_BB0131_NAMES  16
+#define SWEET_BB0131_GROWS  8
+#define SWEET_BB0131_REFS   16
+#define SWEET_BB0131_SHOW   2           /* ring entries printed at dump time */
+
+void sweet_bb0131_name(mach_port_name_t nm, uint64_t sp);
+void sweet_bb0131_grow(uint64_t sp, uint32_t old_count, uint32_t new_count);
+void sweet_bb0131_ref(uint32_t kind, uint32_t nm, uint64_t sp, int32_t a,
+    int32_t b, int32_t kr);
+void sweet_bb0131_dump(const char *why);
+
+struct sweet_bb0131_nm { uint64_t sp; uint32_t nm; uint32_t idx; };
+struct sweet_bb0131_gr { uint64_t sp; uint32_t oldc; uint32_t newc; };
+struct sweet_bb0131_rf {
+	uint64_t sp;
+	uint32_t nm;
+	int32_t kind;
+	int32_t a;
+	int32_t b;
+	int32_t kr;
+};
+
+static struct sweet_bb0131_nm sweet_bb0131_nms[SWEET_BB0131_NAMES];
+static struct sweet_bb0131_gr sweet_bb0131_grs[SWEET_BB0131_GROWS];
+static struct sweet_bb0131_rf sweet_bb0131_rfs[SWEET_BB0131_REFS];
+static uint32_t sweet_bb0131_nnm, sweet_bb0131_ngr, sweet_bb0131_nrf;
+static uint32_t sweet_bb0131_maxidx, sweet_bb0131_maxnm;
+static uint64_t sweet_bb0131_maxsp;
+static uint32_t sweet_bb0131_ghost;
+
+/* every dynamically issued name in the kernel passes through ipc_entry_claim() */
+void
+sweet_bb0131_name(mach_port_name_t nm, uint64_t sp)
+{
+	uint32_t idx = (uint32_t)MACH_PORT_INDEX(nm);
+	struct sweet_bb0131_nm *p;
+
+	if (idx > sweet_bb0131_maxidx) {
+		sweet_bb0131_maxidx = idx;
+		sweet_bb0131_maxnm = (uint32_t)nm;
+		sweet_bb0131_maxsp = sp;
+	}
+	if ((uint32_t)nm == (uint32_t)SWEET_GHOST_NAME) {
+		sweet_bb0131_ghost++;
+	}
+	if (idx < SWEET_BB0131_BIG) {
+		return;
+	}
+	p = &sweet_bb0131_nms[sweet_bb0131_nnm % SWEET_BB0131_NAMES];
+	sweet_bb0131_nnm++;
+	p->sp = sp;
+	p->nm = (uint32_t)nm;
+	p->idx = idx;
+}
+
+/* the name table of a space only ever grows; 32 entries is the initial size */
+void
+sweet_bb0131_grow(uint64_t sp, uint32_t old_count, uint32_t new_count)
+{
+	struct sweet_bb0131_gr *p =
+	    &sweet_bb0131_grs[sweet_bb0131_ngr % SWEET_BB0131_GROWS];
+
+	sweet_bb0131_ngr++;
+	p->sp = sp;
+	p->oldc = old_count;
+	p->newc = new_count;
+}
+
+/* real arguments of the port-right calls that fail on a name */
+void
+sweet_bb0131_ref(uint32_t kind, uint32_t nm, uint64_t sp, int32_t a, int32_t b,
+    int32_t kr)
+{
+	struct sweet_bb0131_rf *p =
+	    &sweet_bb0131_rfs[sweet_bb0131_nrf % SWEET_BB0131_REFS];
+
+	if (nm == (uint32_t)SWEET_GHOST_NAME) {
+		sweet_bb0131_ghost++;
+	}
+	sweet_bb0131_nrf++;
+	p->sp = sp;
+	p->nm = nm;
+	p->kind = (int32_t)kind;
+	p->a = a;
+	p->b = b;
+	p->kr = kr;
+}
+
+void
+sweet_bb0131_dump(const char *why)
+{
+	task_t t = current_task();
+	ipc_space_t space = (t != TASK_NULL) ? t->itk_space : IS_NULL;
+	uint32_t cap = 0, i, start, show;
+
+	if (space != IS_NULL && is_active(space)) {
+		ipc_entry_table_t table = is_active_table(space);
+
+		cap = (uint32_t)ipc_entry_table_count(table);
+		printf("0131 TE cap %u\n", cap);
+		for (i = 1; i < cap; i++) {
+			ipc_entry_t e = ipc_entry_table_get(table, i);
+			mach_port_gen_t gen;
+
+			if (e == IE_NULL || e->ie_object == IO_NULL) {
+				continue;
+			}
+			gen = (mach_port_gen_t)(IE_BITS_GEN(e->ie_bits) >> 24);
+			printf("0131 TI %u nm 0x%x b 0x%x\n", i,
+			    (uint32_t)MACH_PORT_MAKE(i, gen),
+			    (uint32_t)e->ie_bits);
+		}
+	} else {
+		printf("0131 TE sp 0x%llx no space\n", (uint64_t)space);
+	}
+
+	printf("0131 GT n %u\n", sweet_bb0131_ngr);
+	start = (sweet_bb0131_ngr > SWEET_BB0131_GROWS) ?
+	    (sweet_bb0131_ngr - SWEET_BB0131_GROWS) : 0;
+	for (i = start, show = 0;
+	    i < sweet_bb0131_ngr && show < SWEET_BB0131_SHOW; i++, show++) {
+		struct sweet_bb0131_gr *p =
+		    &sweet_bb0131_grs[i % SWEET_BB0131_GROWS];
+		printf("0131 G sp 0x%llx %u to %u\n", p->sp, p->oldc, p->newc);
+	}
+
+	printf("0131 AT n %u\n", sweet_bb0131_nnm);
+	start = (sweet_bb0131_nnm > SWEET_BB0131_NAMES) ?
+	    (sweet_bb0131_nnm - SWEET_BB0131_NAMES) : 0;
+	for (i = start, show = 0;
+	    i < sweet_bb0131_nnm && show < SWEET_BB0131_SHOW; i++, show++) {
+		struct sweet_bb0131_nm *p =
+		    &sweet_bb0131_nms[i % SWEET_BB0131_NAMES];
+		printf("0131 A nm 0x%x idx %u sp 0x%llx\n", p->nm, p->idx, p->sp);
+	}
+
+	printf("0131 RT n %u\n", sweet_bb0131_nrf);
+	start = (sweet_bb0131_nrf > SWEET_BB0131_REFS) ?
+	    (sweet_bb0131_nrf - SWEET_BB0131_REFS) : 0;
+	for (i = start, show = 0;
+	    i < sweet_bb0131_nrf && show < SWEET_BB0131_SHOW; i++, show++) {
+		struct sweet_bb0131_rf *p =
+		    &sweet_bb0131_rfs[i % SWEET_BB0131_REFS];
+		printf("0131 R k %d nm 0x%x a %d b %d kr %d sp 0x%llx\n", p->kind,
+		    p->nm, p->a, p->b, p->kr, p->sp);
+	}
+
+	printf("0131 KEY %s ghost %u maxidx %u maxnm 0x%x maxsp 0x%llx\n", why,
+	    sweet_bb0131_ghost, sweet_bb0131_maxidx, sweet_bb0131_maxnm,
+	    sweet_bb0131_maxsp);
+}
