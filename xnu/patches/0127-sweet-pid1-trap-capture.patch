+	 * phone, and this path also covers raise()/kill() driven deaths.
+	 */
+	if (p == initproc && (prop & (SA_KILL | SA_CORE))) {
+		extern void sweet_crash_signal_0127(int, uint64_t);
+
+		sweet_crash_signal_0127(signum, (uint64_t)signal_reason);
+	}
+
