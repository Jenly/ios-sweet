diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,11 +514,25 @@
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/*
+	 * Stage 0: white 64x32 band, no stack or page tables needed.
+	 *
+	 * The address and stride come from boot_args (x20), not from constants. They
+	 * used to be `0x9c000000 + 2368*4320` and `4320` -- sweet's splash region --
+	 * which on chiron is 20 MiB from the real framebuffer (0x9d400000). This write
+	 * therefore landed in memory that is not the display, before there was a stack
+	 * or any way to report it, and the kernel stopped there.
+	 *
+	 * The shim fills Video from the device tree, so these values are correct for
+	 * whichever board is running.
+	 *
+	 * The band is drawn at the top of the panel. It used to be at row 2368 of a
+	 * 2400-row screen; chiron's panel is 2160 rows.
+	 */
+	ldr		x0, [x20, BA_VIDEO_BASE]
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	ldr		x4, [x20, BA_VIDEO_ROW_BYTES]
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -686,7 +700,7 @@
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, BA_VIDEO_BASE]
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,13 +11,48 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+/*
+ * The framebuffer this console draws on, and the panel's shape.
+ *
+ * These used to be constants: 0x9c000000 and 1080x2400 with a 4320-byte stride --
+ * sweet's splash region. chiron's is 0x9d400000 with a 2160-row panel, so on that
+ * board the early console wrote 20 MiB into memory that is not the display and used
+ * 240 rows that do not exist. The early console is what reports a panic before the
+ * normal console is up, so being wrong here means silence at the worst moment.
+ *
+ * arm_vm_init() calls sweet_early_set_fb() with the values the boot shim read out of
+ * the device tree, which are correct for whichever board is running. The defaults
+ * below keep the previous behaviour for any path that does not.
+ */
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static uint32_t early_width = 1080u;
+static uint32_t early_height = 2400u;
+static uint32_t early_stride = 4320u / 4u;      /* in pixels, not bytes */
+
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
+
+/*
+ * Point the early console at a framebuffer. Called once, early, from arm_vm_init()
+ * with the boot_args the shim filled in. `stride_bytes` is converted to pixels here
+ * so the rest of the file keeps its existing arithmetic.
+ */
+void
+sweet_early_set_fb(uint64_t base, uint32_t width, uint32_t height,
+    uint32_t stride_bytes)
+{
+	if (base == 0 || width == 0 || height == 0 || stride_bytes < 4u) {
+		return;                 /* leave the defaults: better than a bad pointer */
+	}
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_width = width;
+	early_height = height;
+	early_stride = stride_bytes / 4u;
+}
 #define EARLY_CELL_H (16u * EARLY_SCALE)
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
 #define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
