+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -1034,6 +1040,8 @@ common_start:
 #endif
 
 	SWEET_LOG_MARK 25, Lsweet_log25
