+
 	SWEET_LOG_MARK 21, Lsweet_log21
 	SWEET_LOG_MARK 22, Lsweet_log22
 	SWEET_LOG_MARK 23, Lsweet_log23
 	SWEET_LOG_MARK 24, Lsweet_log24
 
+	SWEET_STAGE 7, 0xFF808080	/* gray: log marks 21-24 done (KVA stack OK) */
