diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -535,6 +535,43 @@
 .endm
 #endif
 
+#if defined(SWEET)
+/*
+ * SWEET staged boot band, explicit-base variant.
+ *
+ * Same painter as SWEET_STAGE, but the caller supplies the framebuffer base, so
+ * the pre-MMU sites can pass the physical address from boot_args and any future
+ * post-MMU site can pass whatever address form it actually needs.
+ *
+ * The framebuffer is used at its PHYSICAL address on both sides of the MMU
+ * enable, deliberately: TTBR0 holds the V=P (identity) table and T0SZ_BOOT is 17
+ * for 16K pages, so VA 0..2^47 maps one-to-one, and the panel at 0x9D400000 is
+ * in that window with a block descriptor the SWEET code installed itself. A KVA
+ * (pa + virtBase - physBase) would land below the kernel mapping in the TTBR1
+ * window, where nothing is mapped.
+ *
+ * Clobbers x9-x13 only.
+ */
+.macro SWEET_STAGE_MMU idx, colour
+	ldr		x10, [x20, BA_VIDEO_ROW_BYTES]
+	mov		x11, #(800 + \idx * 16)
+	madd	x9, x10, x11, x9
+	movz	x12, #((\colour >> 0) & 0xFFFF)
+	movk	x12, #((\colour >> 16) & 0xFFFF), lsl #16
+	mov		x13, #12
+Lsweet_mmu_row\@:
+	mov		x11, #16
+Lsweet_mmu_px\@:
+	str		w12, [x9], #4
+	subs	x11, x11, #1
+	b.ne	Lsweet_mmu_px\@
+	add		x9, x9, x10
+	sub		x9, x9, #64
+	subs	x13, x13, #1
+	b.ne	Lsweet_mmu_row\@
+.endm
+#endif
+
 /*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
@@ -805,6 +842,9 @@
  */
 common_start:
 
+	ldr		x9, [x20, BA_VIDEO_BASE]
+	SWEET_STAGE_MMU 6, 0xFF00FFFF	/* cyan: in common_start */
+
 #if HAS_NEX_PG
 	mov x19, lr
 	bl		EXT(set_nex_pg)
@@ -879,6 +919,8 @@
 	ic		iallu
 #endif
 
+	ldr		x9, [x20, BA_VIDEO_BASE]
+	SWEET_STAGE_MMU 7, 0xFF404040	/* grey: about to enable MMU */
 #if defined(SWEET)
 	/* Complete local TLB/I-cache invalidation before enabling the MMU. */
 	dsb		sy
@@ -923,6 +965,12 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET)
+	/* MMU is on; the panel is still at its physical address (see the macro). */
+	ldr		x9, [x20, BA_VIDEO_BASE]
+	SWEET_STAGE_MMU 8, 0xFF0000FF	/* blue: MMU enabled */
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -939,6 +987,8 @@
 	// Enable NEON
 	mov		x0, #(CPACR_FPEN_ENABLE)
 	msr		CPACR_EL1, x0
+	ldr		x9, [x20, BA_VIDEO_BASE]
+	SWEET_STAGE_MMU 9, 0xFFFF8000	/* orange: NEON/CPACR done */
 #endif
 
 	// Clear thread pointer
@@ -985,6 +1035,8 @@
 	mov	lr, x21
 #endif
 
+	ldr		x9, [x20, BA_VIDEO_BASE]
+	SWEET_STAGE_MMU 10, 0xFF8000FF	/* violet: returning to arm_init */
 	// Return to arm_init()
 	ret
 
