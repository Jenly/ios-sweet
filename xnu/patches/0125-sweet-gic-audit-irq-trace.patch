@@ -74,4 +118,79 @@ find_gicr_pe_base()
 }
 
+#if defined(SWEET)
+/*
+ * 0125: GIC / interrupt-delivery audit, called from SweetCPU::startAll before
+ * the first SGI is sent.  Prints the state the platform handed us, repairs the
+ * pieces that can silently stop every delivery, and prints what the writes
+ * landed.  IntIDs seen are counted by sleh_irq and printed by the caller.
+ */
+void
+sweet_gic_audit(void)
+{
+	uint32_t waker;
+	uint32_t gicd_ctlr;
+	unsigned int i;
+
+	kprintf("PRB 36 GIC boot: d=%lx r=%lx pe=%lx ctlr=%x typer=%x/%llx waker=%x en0=%x\n",
+	    (unsigned long)sweet_gicd_va, (unsigned long)sweet_gicr_va,
+	    (unsigned long)sweet_pe_base, sweet_boot_gicd_ctlr, sweet_boot_gicd_typer,
+	    sweet_boot_gicr_typer, sweet_boot_gicr_waker, sweet_boot_gicr_en0);
+	kprintf("PRB 37 ICC boot: sre=%llx pmr=%llx bpr1=%llx igrp1=%llx hppir=%llx vt=%u/%u\n",
+	    sweet_boot_icc_sre, sweet_boot_icc_pmr,
+	    __builtin_arm_rsr64("ICC_BPR1_EL1"), sweet_boot_icc_igrp1,
+	    sweet_boot_icc_hppir, sweet_vtimer_intid, sweet_vtimer_intid_alt);
+	kprintf("PRB 38 timer: cntv_ctl=%llx cntv_cval=%llx cntvct=%llx cntpct=%llx frq=%llx irqcnt=%llx trace=%llx\n",
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_CVAL_EL0"),
+	    __builtin_arm_rsr64("CNTVCT_EL0"), __builtin_arm_rsr64("CNTPCT_EL0"),
+	    __builtin_arm_rsr64("CNTFRQ_EL0"), sweet_irq_count, sweet_irq_trace);
+
+	/*
+	 * Wake the redistributor.  pe_init_fiq() only writes GICR_WAKER when
+	 * ChildrenAsleep already reads set, so a PE sitting in ProcessorSleep
+	 * alone is never woken -- and a sleeping PE receives nothing at all.
+	 */
+	waker = sweet_gicr_rd32(GICR_WAKER);
+	if (waker & GICR_WAKER_PROCESSORSLEEP) {
+		sweet_gicr_wr32(GICR_WAKER, waker & ~GICR_WAKER_PROCESSORSLEEP);
+		for (i = 0; i < 1000000U; i++) {
+			if (!(sweet_gicr_rd32(GICR_WAKER) & GICR_WAKER_CHILDRENASLEEP)) {
+				break;
+			}
+		}
+	}
+
+	/*
+	 * SGI1 for the IPI path plus the whole PPI range.  The ADT says this SoC
+	 * wires the virtual timer to INTID 27 while the shim measured 19 on
+	 * Qualcomm parts; enabling the PPIs costs nothing (an unhandled one is
+	 * EOId by sleh_irq) and the trace then says which INTID actually fires.
+	 */
+	sweet_gicr_wr32(GICR_IGROUPR0, 0xFFFFFFFF);
+	sweet_gicr_wr32(GICR_ISENABLER0, 0xFFFF0002U);
+
+	gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	for (i = 0; i < 1000000U; i++) {
+		if (!(gicd_read32(GICD_CTLR) & GICD_CTLR_RWP)) {
+			break;
+		}
+	}
+
+	__builtin_arm_wsr64("ICC_SRE_EL1", __builtin_arm_rsr64("ICC_SRE_EL1") | ICC_SRE_SRE);
+	__builtin_arm_isb(ISB_SY);
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+
+	kprintf("PRB 39 GIC now: ctlr=%x waker=%x en0=%x sre=%llx pmr=%llx igrp1=%llx hppir=%llx\n",
+	    gicd_read32(GICD_CTLR), sweet_gicr_rd32(GICR_WAKER),
+	    sweet_gicr_rd32(GICR_ISENABLER0),
+	    __builtin_arm_rsr64("ICC_SRE_EL1"), __builtin_arm_rsr64("ICC_PMR_EL1"),
+	    __builtin_arm_rsr64("ICC_IGRPEN1_EL1"), __builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+}
+#endif /* SWEET */
+
 void
 pe_init_fiq()
