+/*
+ * 0125: interrupt-delivery audit.
+ *
+ * chiron takes no interrupt at all: the self-SGI that clears SIGPdisabled
+ * never arrives, so SweetCPU::startAll parks for its whole deadline, and the
+ * IORC wait in IOKitInitializeTime never expires -- yet CNTPCT keeps running
+ * and both DAIF and ICC_PMR_EL1 say IRQs are unmasked.  The identical kernel
+ * boots through to load_init_program() under QEMU, so the state the platform
+ * handed the GIC to us in is the suspect.  Snapshot it while it is still
+ * fresh, report it from inside the console scrollback window instead of
+ * trusting the early log to survive, then rewrite everything we depend on and
+ * say what the writes landed.
+ */
+#if defined(SWEET)
+uint64_t sweet_irq_count = 0;           /* IRQs taken since boot */
+uint64_t sweet_irq_trace = 0;           /* first 8 INTIDs, 8 bits each */
+uint32_t sweet_vtimer_intid_alt = SWEET_VTIMER_INTID;  /* board default, 19 */
+
+static vm_offset_t sweet_pe_base;
+static vm_offset_t sweet_gicd_va;
+static vm_offset_t sweet_gicr_va;
+static uint32_t sweet_boot_gicd_ctlr;
+static uint32_t sweet_boot_gicd_typer;
+static uint64_t sweet_boot_gicr_typer;
+static uint32_t sweet_boot_gicr_waker;
+static uint32_t sweet_boot_gicr_en0;
+static uint64_t sweet_boot_icc_sre;
+static uint64_t sweet_boot_icc_pmr;
+static uint64_t sweet_boot_icc_igrp1;
+static uint64_t sweet_boot_icc_hppir;
+
+static uint32_t
+sweet_gicr_rd32(uint32_t off)
+{
+	return _gic_read32(sweet_pe_base + off);
+}
+
+static void
+sweet_gicr_wr32(uint32_t off, uint32_t value)
+{
+	_gic_write32(sweet_pe_base + off, value);
+}
+#endif /* SWEET */
+
 static vm_offset_t
