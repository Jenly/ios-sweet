+		sweet_boot_gicr_en0   = gicr_read32(GICR_ISENABLER0);
+		sweet_boot_icc_sre    = __builtin_arm_rsr64("ICC_SRE_EL1");
+		sweet_boot_icc_pmr    = __builtin_arm_rsr64("ICC_PMR_EL1");
+		sweet_boot_icc_igrp1  = __builtin_arm_rsr64("ICC_IGRPEN1_EL1");
+		sweet_boot_icc_hppir  = __builtin_arm_rsr64("ICC_HPPIR1_EL1");
+	}
+#endif
 
