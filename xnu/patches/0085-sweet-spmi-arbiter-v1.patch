diff --git a/bsd/dev/sweet_pm8998_reg.c b/bsd/dev/sweet_pm8998_reg.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_pm8998_reg.c
@@ -0,0 +1,318 @@
+/*
+ * sweet_pm8998_reg.c -- PM8998 LDO control for chiron's touch rails.
+ *
+ * SAFETY MODEL. This is the first code in the port that WRITES to the PMIC, and
+ * that PMIC also feeds the CPU rails, so the constraints are deliberately severe:
+ *
+ *   1. OFF BY DEFAULT. Nothing here runs unless the boot-arg
+ *      `sweetpmic=1` is given. Without it every entry point returns
+ *      -1 immediately and the PMIC is never touched.
+ *
+ *   2. SET-ONLY. The only write is "enable". There is no disable path, no
+ *      voltage change, no mode change, no pull-down, no soft-start. A regulator
+ *      that is already on stays on with the voltage and mode the bootloader
+ *      chose, which is what the display and touch controller were brought up
+ *      against.
+ *
+ *   3. WHITELISTED RAILS. Only PM8998 L6 and L14 (chiron's touch vdd and
+ *      analogue rail, chiron-msm8998-mtp.dtsi:214,217) can be addressed. Rails
+ *      that feed the CPUs, DDR or the eMMC/UFS are not reachable by name, and
+ *      the range check rejects anything outside the two entries.
+ *
+ *   4. READ-BACK. After writing the enable bit the register is read again; a
+ *      rail that does not read back enabled is reported as a failure rather
+ *      than assumed to be up.
+ *
+ *   5. NO BLIND RETRY. If the write does not take, this reports and stops. It
+ *      never loops on the PMIC.
+ *
+ * What is deliberately NOT done: LAB/IBB (pmi8998), which drive the display
+ * backlight and need correct current-limit programming that cannot be validated
+ * from software yet. They are left exactly as the bootloader set them.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>		/* delay(), under XNU_KERNEL_PRIVATE */
+#include <pexpert/pexpert.h>
+
+#include "sweet_pm8998_reg.h"
+#include "sweet_spmi_v1.h"
+
+/*
+ * SPMI write, minimal and local to this file.
+ *
+ * The v1 arbiter command for a one-byte extended write is opcode 0
+ * (PMIC_ARB_OP_EXT_WRITEL, spmi-pmic-arb.c:76) with byte count 0 and the data in
+ * WDATA0 (PMIC_ARB_WDATA0 = +0x10, spmi-pmic-arb.c:41). Kept private rather than
+ * added to sweet_spmi_v1.c so that the general SPMI path stays read-only: a
+ * write can only happen through this whitelisted regulator entry point.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_V1_CORE_PA   0x0800f000u
+#define SP_V1_CORE_SZ   0x00001000u
+#define SP_V1_OBS_PA    0x09400000u
+#define SP_V1_OBS_SZ    0x01000000u
+#define SP_V1_CFG_PA    0x0800a000u
+#define SP_V1_CFG_SZ    0x00003000u
+
+#define SP_CH_CMD       0x00u
+#define SP_CH_STATUS    0x08u
+#define SP_CH_WDATA0    0x10u
+#define SP_CH_RDATA0    0x18u
+
+#define SP_STATUS_DONE  0x1u
+#define SP_STATUS_ERRORS 0x0eu
+
+#define SP_OP_EXT_WRITEL 0u
+#define SP_OP_EXT_READL  1u
+
+#define SP_CHANNEL_MAP_OFF(n) (0x800u + 0x4u * (n))
+#define SP_OBS_OFF(ch)        (0x800u + 0x80u * (ch))
+#define SP_FMT_CMD_V1(opc, sid, addr, bc) \
+	(((opc) << 27) | (((sid) & 0xfu) << 20) | (((addr) & 0xffffu) << 4) | ((bc) & 0x7u))
+
+#define SP_NO_APID      0xffffu
+#define SP_MAX_APIDS    512u
+#define SP_PPID_MASK    0xfffu
+#define SP_POLL_LIMIT   1000u
+
+static vm_offset_t pm_core, pm_obs, pm_cfg;
+static unsigned    pm_apids;
+static bool        pm_mapped;
+static bool        pm_considered;
+static bool        pm_allowed;
+static int         pm_sleep_chan;
+
+static uint32_t
+pm_rd(vm_offset_t base, unsigned off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static uint16_t
+pm_find_apid(unsigned ppid)
+{
+	for (unsigned i = 0; i < pm_apids; i++) {
+		uint32_t map = pm_rd(pm_core, SP_CHANNEL_MAP_OFF(i));
+
+		if (map == 0 || ((map >> 8) & SP_PPID_MASK) != ppid) {
+			continue;
+		}
+		if ((pm_rd(pm_cfg, 0x700u + 4u * i) & 0x7u) == 0) {
+			return (uint16_t)i;
+		}
+	}
+	return SP_NO_APID;
+}
+
+/* One SPMI transaction. write != 0 stores `data`; otherwise reads into *data. */
+static int
+pm_xfer(unsigned sid, unsigned addr, uint8_t *data, int write)
+{
+	unsigned off, base;
+	uint16_t apid;
+	uint32_t cmd, status;
+
+	if (!pm_mapped || data == NULL) {
+		return -1;
+	}
+	apid = pm_find_apid(((sid & 0xfu) << 8) | ((addr >> 8) & 0xffu));
+	if (apid == SP_NO_APID) {
+		return -1;
+	}
+	base = SP_OBS_OFF(0);
+	off = base + 0x80u * apid;
+
+	__asm__ volatile("dmb oshst" ::: "memory");
+	if (write) {
+		*(volatile uint32_t *)(pm_obs + off + SP_CH_WDATA0) = *data;
+		__asm__ volatile("dmb oshst" ::: "memory");
+	}
+	cmd = SP_FMT_CMD_V1(write ? SP_OP_EXT_WRITEL : SP_OP_EXT_READL,
+	    sid, addr, 0);
+	*(volatile uint32_t *)(pm_obs + off + SP_CH_CMD) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	for (unsigned i = 0; i < SP_POLL_LIMIT; i++) {
+		status = pm_rd(pm_obs, off + SP_CH_STATUS);
+		if (status & SP_STATUS_DONE) {
+			if (status & SP_STATUS_ERRORS) {
+				return -1;
+			}
+			if (!write) {
+				*data = (uint8_t)pm_rd(pm_obs, off + SP_CH_RDATA0);
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;      /* timed out; the caller must not retry blindly */
+}
+
+/*
+ * Gate. Everything below is inert unless sweetpmic=1 and the v1 arbiter is
+ * present. `pm_considered` makes the decision once per boot.
+ */
+static int
+pm_allowed_once(void)
+{
+	int want = 0;
+
+	if (pm_considered) {
+		return pm_allowed ? 0 : -1;
+	}
+	pm_considered = true;
+
+	if (!PE_parse_boot_argn("sweetpmic", &want, sizeof(want)) || want != 1) {
+		printf("SWEET PM8998: not enabled (boot-arg sweetpmic=1 required); "
+		    "regulators left exactly as the bootloader set them\n");
+		return -1;
+	}
+	if (sweet_spmi_v1_init() != 0) {
+		printf("SWEET PM8998: no v1 SPMI arbiter; cannot reach the PMIC\n");
+		return -1;
+	}
+
+	pm_core = ml_io_map(SP_V1_CORE_PA, SP_V1_CORE_SZ);
+	pm_obs  = ml_io_map(SP_V1_OBS_PA, SP_V1_OBS_SZ);
+	pm_cfg  = ml_io_map(SP_V1_CFG_PA, SP_V1_CFG_SZ);
+	if (pm_core == 0 || pm_obs == 0 || pm_cfg == 0) {
+		printf("SWEET PM8998: PMIC window mapping failed\n");
+		return -1;
+	}
+	pm_apids = SP_MAX_APIDS;
+
+	/*
+	 * Prove the PMIC answers before allowing any write: read the PM8998
+	 * revision register pair (PERPH 0x01, address 0x0100/0x0101 on SID 0).
+	 * A dead bus reads 0x00 or 0xff for both bytes.
+	 */
+	{
+		uint8_t rev0 = 0, rev1 = 0;
+
+		if (pm_xfer(PM8998_SID, 0x0100u, &rev0, 0) != 0 ||
+		    pm_xfer(PM8998_SID, 0x0101u, &rev1, 0) != 0 ||
+		    (rev0 == 0 && rev1 == 0) || (rev0 == 0xff && rev1 == 0xff)) {
+			printf("SWEET PM8998: PMIC does not answer at SID 0 "
+			    "(rev %#x %#x); refusing to write\n", rev0, rev1);
+			return -1;
+		}
+		printf("SWEET PM8998: PMIC revision %u.%u, writes permitted for "
+		    "L6/L14 only\n", rev1, rev0);
+	}
+
+	pm_mapped = true;
+	pm_allowed = true;
+	return 0;
+}
+
+static int
+pm_rail_ok(unsigned ldo)
+{
+	/* Only the two rails chiron's touch path uses. */
+	return ldo == PM8998_LDO_L6 || ldo == PM8998_LDO_L14;
+}
+
+int
+sweet_pm8998_read(unsigned ldo, unsigned reg, uint8_t *out)
+{
+	if (!pm_rail_ok(ldo) || reg > 0x7fu || out == NULL) {
+		return -1;
+	}
+	if (pm_allowed_once() != 0) {
+		return -1;
+	}
+	return pm_xfer(PM8998_SID, PM8998_LDO_BASE(ldo) + reg, out, 0);
+}
+
+int
+sweet_pm8998_report(const char *label, unsigned ldo)
+{
+	uint8_t en = 0, mode = 0, range = 0, set = 0;
+
+	if (!pm_rail_ok(ldo)) {
+		printf("SWEET PM8998: rail %u is not whitelisted\n", ldo);
+		return -1;
+	}
+	if (pm_allowed_once() != 0) {
+		return -1;
+	}
+	if (sweet_pm8998_read(ldo, PM8998_REG_ENABLE, &en) != 0 ||
+	    sweet_pm8998_read(ldo, PM8998_REG_MODE, &mode) != 0 ||
+	    sweet_pm8998_read(ldo, PM8998_REG_VOLTAGE_RANGE, &range) != 0 ||
+	    sweet_pm8998_read(ldo, PM8998_REG_VOLTAGE_SET, &set) != 0) {
+		printf("SWEET PM8998: %s (L%u) unreadable\n",
+		    label != NULL ? label : "?", ldo);
+		return -1;
+	}
+
+	printf("SWEET PM8998: %s (L%u) enable=%s mode=%s range=%u set=%u\n",
+	    label != NULL ? label : "?", ldo,
+	    (en & PM8998_ENABLE_BIT) ? "on" : "off",
+	    (mode & PM8998_MODE_HPM) ? "HPM" :
+	    ((mode & PM8998_MODE_AUTO) ? "AUTO" : "LPM"),
+	    range, set);
+
+	return (en & PM8998_ENABLE_BIT) ? 1 : 0;
+}
+
+int
+sweet_pm8998_enable(const char *label, unsigned ldo)
+{
+	uint8_t en = 0;
+
+	if (!pm_rail_ok(ldo)) {
+		printf("SWEET PM8998: refusing to touch rail %u (not whitelisted)\n",
+		    ldo);
+		return -1;
+	}
+	if (pm_allowed_once() != 0) {
+		return -1;
+	}
+	if (sweet_pm8998_read(ldo, PM8998_REG_ENABLE, &en) != 0) {
+		printf("SWEET PM8998: %s (L%u) enable register unreadable\n",
+		    label != NULL ? label : "?", ldo);
+		return -1;
+	}
+	if (en & PM8998_ENABLE_BIT) {
+		/*
+		 * Already on -- leave it alone. This is the expected case when a
+		 * bootloader powered the panel, and there is no reason to rewrite
+		 * a register that already says what we want.
+		 */
+		printf("SWEET PM8998: %s (L%u) already enabled (%#x); no write\n",
+		    label != NULL ? label : "?", ldo, en);
+		return 0;
+	}
+
+	/*
+	 * SET-ONLY: OR in the enable bit, keep every other bit as it is. Never
+	 * write 0x80 outright, because the low nibble carries the hardware
+	 * enable-follow bits (SPMI_COMMON_ENABLE_FOLLOW_*_MASK) which the
+	 * bootloader may have configured.
+	 */
+	{
+		uint8_t want = (uint8_t)(en | PM8998_ENABLE_BIT);
+
+		if (pm_xfer(PM8998_SID, PM8998_LDO_BASE(ldo) + PM8998_REG_ENABLE,
+		    &want, 1) != 0) {
+			printf("SWEET PM8998: %s (L%u) enable write failed; "
+			    "leaving the rail as it was\n",
+			    label != NULL ? label : "?", ldo);
+			return -1;
+		}
+	}
+
+	/* Read back rather than assume. */
+	if (sweet_pm8998_read(ldo, PM8998_REG_ENABLE, &en) != 0 ||
+	    !(en & PM8998_ENABLE_BIT)) {
+		printf("SWEET PM8998: %s (L%u) did not read back enabled (%#x)\n",
+		    label != NULL ? label : "?", ldo, en);
+		return -1;
+	}
+	printf("SWEET PM8998: %s (L%u) enabled (now %#x)\n",
+	    label != NULL ? label : "?", ldo, en);
+	return 0;
+}
diff --git a/bsd/dev/sweet_pm8998_reg.h b/bsd/dev/sweet_pm8998_reg.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_pm8998_reg.h
@@ -0,0 +1,98 @@
+/*
+ * sweet_pm8998_reg.h -- PM8998 regulator control over the v1 SPMI arbiter.
+ *
+ * Why this exists: chiron's touch controller is powered from pm8998_l6 and its
+ * analogue rail from pm8998_l14 (xiaomi/chiron-msm8998-mtp.dtsi:214,217):
+ *
+ *     vdd-supply  = <&pm8998_l6>;      synaptics,pwr-reg-name = "vdd";
+ *     disp-supply = <&pm8998_l14>;     synaptics,bus-reg-name = "avdd";
+ *
+ * On the Android side the PMIC leaves those rails up. Whether a bootloader
+ * handoff keeps them up is unknown, so the touch driver needs to be able to turn
+ * them on itself. Today chiron_touch.c only notes the supplies in a comment.
+ *
+ * REGISTER MAP -- from qcom_spmi-regulator.c in this workspace, which is the
+ * authority rather than a datasheet guess:
+ *
+ *   module bases (spmi_regulator_data tables, qcom_spmi-regulator.c:1441-1510)
+ *       l1  0x4000    l2  0x4100   ...   l6  0x4500   ...   l14 0x4d00
+ *       i.e. 0x4000 + 0x100 * (n - 1)
+ *
+ *   control registers, common to every QPNP regulator
+ *   (qcom_spmi-regulator.c:159-166, "these are offsets from 0x40"):
+ *       +0x40 VOLTAGE_RANGE
+ *       +0x41 VOLTAGE_SET
+ *       +0x45 MODE
+ *       +0x46 ENABLE          <- SPMI_COMMON_REG_ENABLE
+ *
+ *   enable bits (qcom_spmi-regulator.c:193-195)
+ *       ENABLE_MASK 0x80   ENABLE 0x80   DISABLE 0x00
+ *
+ *   mode bits (qcom_spmi-regulator.c:203-206)
+ *       HPM 0x80 (high power mode)   AUTO 0x40   BYPASS 0x20
+ *
+ *   the driver's own enable path is
+ *       spmi_regulator_common_enable -> update_bits(REG_ENABLE, 0x80, 0x80)
+ *   (qcom_spmi-regulator.c:505-511) so writing 0x80 into +0x46 is exactly what
+ *   Linux does.
+ *
+ * SID: pm8998 sits at SPMI slave 0 (msm-pm8998.dtsi:18, "qcom,pm8998@0").
+ *
+ * PUMP/IBB (lab-supply, ibb-supply) are PMI8998 LAB/IBB regulators with their
+ * own module types and current-limit programming. They are NOT touched here:
+ * they drive the display backlight, not the touch panel, and getting their
+ * current limits wrong is a hardware risk with no way to validate it from
+ * software yet.
+ */
+
+#ifndef SWEET_PM8998_REG_H
+#define SWEET_PM8998_REG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* PM8998 LDO module bases, qcom_spmi-regulator.c:1446-1466 */
+#define PM8998_LDO_BASE(n)     (0x4000u + 0x100u * ((n) - 1u))
+
+#define PM8998_LDO_L6          6u
+#define PM8998_LDO_L14         14u
+
+/* Common control register offsets from the module base */
+#define PM8998_REG_VOLTAGE_RANGE  0x40u
+#define PM8998_REG_VOLTAGE_SET    0x41u
+#define PM8998_REG_MODE           0x45u
+#define PM8998_REG_ENABLE         0x46u
+
+#define PM8998_ENABLE_BIT         0x80u
+#define PM8998_MODE_HPM           0x80u
+#define PM8998_MODE_AUTO          0x40u
+
+#define PM8998_SID                0u
+
+/*
+ * Read one regulator control register. 0 on success.
+ * Needs sweet_spmi_v1_init() to have succeeded.
+ */
+int sweet_pm8998_read(unsigned ldo, unsigned reg, uint8_t *out);
+
+/*
+ * Report what an LDO currently looks like: enable state, mode, voltage selector.
+ * Logs one line; never writes. Returns 1 if enabled, 0 if not, -1 on error.
+ */
+int sweet_pm8998_report(const char *label, unsigned ldo);
+
+/*
+ * Ensure an LDO is enabled. If it already is, this is a no-op and says so --
+ * the common case when a bootloader already brought the panel up.
+ * Returns 0 if the rail ends up enabled, negative otherwise.
+ */
+int sweet_pm8998_enable(const char *label, unsigned ldo);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SWEET_PM8998_REG_H */
diff --git a/bsd/dev/sweet_spmi_v1.c b/bsd/dev/sweet_spmi_v1.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_spmi_v1.c
@@ -0,0 +1,245 @@
+/*
+ * sweet_spmi_v1.c -- SPMI PMIC-Arbiter v1 read path for MSM8998 (chiron).
+ *
+ * See sweet_spmi_v1.h for why this is a separate implementation and for the
+ * register-level citations. Every constant below is traced to a line in
+ * LineageOS/android_kernel_xiaomi_msm8998.
+ *
+ * Read-only: the only command ever issued is EXT_READL (opcode 1).
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+
+#include "sweet_spmi_v1.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/* msm8998.dtsi:593-604, reg-names core/chnls/obsrvr/intr/cnfg */
+#define SP_V1_CORE_PA   0x0800f000u
+#define SP_V1_CORE_SZ   0x00001000u
+#define SP_V1_OBS_PA    0x09400000u
+#define SP_V1_OBS_SZ    0x01000000u
+#define SP_V1_CFG_PA    0x0800a000u
+#define SP_V1_CFG_SZ    0x00003000u
+
+/* spmi-pmic-arb.c:30 -- the version word lives at core+0 */
+#define SP_ARB_VERSION          0x0000u
+/* spmi-pmic-arb.c:32-33 -- below V2_MIN means the v1 layout */
+#define SP_ARB_VERSION_V2_MIN   0x20010000u
+
+/* spmi-pmic-arb.c:37-43 -- per-channel block, same in every generation */
+#define SP_CH_CMD               0x00u
+#define SP_CH_STATUS            0x08u
+#define SP_CH_RDATA0            0x18u
+
+/* spmi-pmic-arb.c:68-72 -- status bits */
+#define SP_STATUS_DONE          0x1u
+#define SP_STATUS_ERRORS        0x0eu   /* FAILURE | DENIED | DROPPED */
+
+/* spmi-pmic-arb.c:75-79 -- opcodes */
+#define SP_OP_EXT_READL         1u
+
+/* spmi-pmic-arb.c:1171-1174 -- APID map inside core */
+#define SP_CHANNEL_MAP_OFF(n)   (0x800u + 0x4u * (n))
+/* spmi-pmic-arb.c:890-895 -- observer window for this execution environment */
+#define SP_OBS_OFF(ch)          (0x800u + 0x80u * (ch))
+/* spmi-pmic-arb.c:1096-1099 -- command encoding for v1 */
+#define SP_FMT_CMD_V1(opc, sid, addr, bc) \
+	(((opc) << 27) | (((sid) & 0xfu) << 20) | (((addr) & 0xffffu) << 4) | ((bc) & 0x7u))
+
+#define SP_NO_APID              0xffffu
+#define SP_MAX_APIDS            512u
+#define SP_PPID_MASK            0xfffu
+#define SP_POLL_LIMIT           1000u
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock     *sp_v1_lock;
+static unsigned    sp_apid_count;
+static unsigned    sp_channel = 0;      /* qcom,channel = <0> (msm8998.dtsi:602) */
+static int         sp_version;
+static bool        sp_attempted, sp_ready;
+/* A command that timed out may still complete: never reuse that lane. */
+static bool        sp_poisoned[SP_MAX_APIDS];
+
+static uint32_t
+spv1_rd(vm_offset_t base, unsigned off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static uint32_t
+spv1_rd_ordered(vm_offset_t base, unsigned off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/*
+ * PPID forms the upper half of the address field: (sid << 8) | peripheral,
+ * where peripheral is addr >> 8. Same scheme the v5 code uses, and the same one
+ * spmi-pmic-arb.c builds its ppid_to_apid table from (regval >> 8).
+ */
+static uint16_t
+spv1_find_apid(unsigned ppid)
+{
+	for (unsigned i = 0; i < sp_apid_count; i++) {
+		uint32_t map = spv1_rd_ordered(sp_core, SP_CHANNEL_MAP_OFF(i));
+		uint32_t owner;
+
+		if (map == 0) {
+			continue;
+		}
+		if (((map >> 8) & SP_PPID_MASK) != ppid) {
+			continue;
+		}
+		/*
+		 * The ownership table says which execution environment may touch
+		 * the peripheral. EE 0 is the AP, which is where this runs; a
+		 * peripheral owned elsewhere would be DENIED anyway, but checking
+		 * first avoids one pointless timed-out transaction.
+		 */
+		owner = spv1_rd_ordered(sp_cfg, 0x700u + 4u * i) & 0x7u;
+		if (owner == 0) {
+			return (uint16_t)i;
+		}
+	}
+	return SP_NO_APID;
+}
+
+int
+sweet_spmi_arb_version(void)
+{
+	return sp_version;
+}
+
+const char *
+sweet_spmi_arb_name(void)
+{
+	switch (sp_version) {
+	case 1:  return "v1 (MSM8998)";
+	case 5:  return "v5 (SM7150)";
+	case 0:  return "not present";
+	default: return "unknown";
+	}
+}
+
+int
+sweet_spmi_v1_init(void)
+{
+	uint32_t version;
+
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+
+	sp_core = ml_io_map(SP_V1_CORE_PA, SP_V1_CORE_SZ);
+	sp_cfg  = ml_io_map(SP_V1_CFG_PA, SP_V1_CFG_SZ);
+	sp_obs  = ml_io_map(SP_V1_OBS_PA, SP_V1_OBS_SZ);
+	if (sp_core == 0 || sp_cfg == 0 || sp_obs == 0) {
+		printf("SWEET SPMI v1: mapping failed (core=%#lx cfg=%#lx obs=%#lx)\n",
+		    (unsigned long)sp_core, (unsigned long)sp_cfg,
+		    (unsigned long)sp_obs);
+		return -1;
+	}
+
+	version = spv1_rd_ordered(sp_core, SP_ARB_VERSION);
+	if (version == 0 || version == 0xFFFFFFFFu) {
+		printf("SWEET SPMI v1: arbiter version reads %#x; block not clocked?\n",
+		    version);
+		return -1;
+	}
+	if (version >= SP_ARB_VERSION_V2_MIN) {
+		/*
+		 * Not the generation this file implements. Refuse rather than
+		 * interpret registers that mean something else here.
+		 */
+		printf("SWEET SPMI v1: arbiter is %#x (v2 or newer); this driver "
+		    "only implements the v1 layout at 0x%x\n",
+		    version, SP_V1_CORE_PA);
+		return -1;
+	}
+
+	/*
+	 * APID count. The v1 arbiter does not publish a count the way v5 does
+	 * (core+4); the usable range is bounded by the mapping table's size in
+	 * the core window, (0x1000 - 0x800) / 4 = 512 entries.
+	 */
+	sp_apid_count = SP_MAX_APIDS;
+
+	sp_v1_lock = IOLockAlloc();
+	if (sp_v1_lock == NULL) {
+		printf("SWEET SPMI v1: cannot allocate the access lock\n");
+		return -1;
+	}
+
+	sp_version = 1;
+	sp_ready = true;
+	printf("SWEET SPMI: arbiter %#x -> %s, channel %u, read-only\n",
+	    version, sweet_spmi_arb_name(), sp_channel);
+	return 0;
+}
+
+int
+sweet_spmi_v1_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	unsigned off, base;
+	uint16_t apid;
+	uint32_t cmd, status;
+
+	if (!sp_ready || out == NULL || addr > 0xffffu || sid > 0xfu) {
+		return -1;
+	}
+
+	IOLockLock(sp_v1_lock);
+
+	apid = spv1_find_apid(((sid & 0xfu) << 8) | ((addr >> 8) & 0xffu));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_v1_lock);
+		return -1;
+	}
+
+	base = SP_OBS_OFF(sp_channel);
+	off = base + 0x80u * apid;
+
+	/*
+	 * EXT_READL, byte count 0 (one byte). PMIC_ARB_CMD is a single 32-bit
+	 * store; the barrier afterwards is what spmi-pmic-arb.c gets from
+	 * readl/writel semantics, made explicit here.
+	 */
+	cmd = SP_FMT_CMD_V1(SP_OP_EXT_READL, sid, addr, 0);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off + SP_CH_CMD) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	for (unsigned i = 0; i < SP_POLL_LIMIT; i++) {
+		status = spv1_rd_ordered(sp_obs, off + SP_CH_STATUS);
+		if (status & SP_STATUS_DONE) {
+			if (status & SP_STATUS_ERRORS) {
+				IOLockUnlock(sp_v1_lock);
+				return -1;
+			}
+			*out = (uint8_t)spv1_rd_ordered(sp_obs,
+			    off + SP_CH_RDATA0);
+			IOLockUnlock(sp_v1_lock);
+			return 0;
+		}
+		delay(1);
+	}
+
+	/*
+	 * Timed out. The transaction may still complete and land in RDATA0
+	 * later, which would corrupt an unrelated read on this lane, so retire
+	 * it for the rest of the boot.
+	 */
+	sp_poisoned[apid] = true;
+	printf("SWEET SPMI v1: apid %u (sid %u addr %#x) timed out; lane retired\n",
+	    apid, sid, addr);
+	IOLockUnlock(sp_v1_lock);
+	return -1;
+}
diff --git a/bsd/dev/sweet_spmi_v1.h b/bsd/dev/sweet_spmi_v1.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_spmi_v1.h
@@ -0,0 +1,78 @@
+/*
+ * sweet_spmi_v1.h -- SPMI PMIC-Arbiter v1 access for MSM8998 (chiron).
+ *
+ * WHY A SECOND SPMI IMPLEMENTATION
+ * sweet_spmi.c speaks the **v5** arbiter protocol used by SM7150/sweet:
+ *
+ *     core  @ 0x0c440000, observer @ 0x0e600000, config @ 0x0c40a000
+ *     APID map at core + 0x900 + 4*n, command ignores SID
+ *     (pmic_arb_channel_map_offset_v5 / pmic_arb_fmt_cmd_v2)
+ *
+ * MSM8998 uses **v1** (arch/arm64/boot/dts/qcom/msm8998.dtsi:593):
+ *
+ *     core  @ 0x0800f000  (0x1000)   <- the arbiter registers
+ *     chnls @ 0x8400000   (0x1000000)
+ *     obsrvr@ 0x9400000   (0x1000000)
+ *     intr  @ 0xa400000
+ *     cnfg  @ 0x0800a000  (0x3000)
+ *
+ *     observer channel stride : 0x800 + 0x80 * channel
+ *                               (pmic_arb_offset_v1, spmi-pmic-arb.c:890)
+ *     APID map at core + 0x800 + 4*n
+ *                               (pmic_arb_channel_map_offset_v2, used by the
+ *                                v1 ops table at spmi-pmic-arb.c:1181-1193)
+ *     command word            : (opc << 27) | ((sid & 0xf) << 20) | (addr << 4) | bc
+ *                               (pmic_arb_fmt_cmd_v1, spmi-pmic-arb.c:1096)
+ *
+ * Pointing the v5 code at MSM8998 would read the wrong registers entirely: the
+ * observer base would land in the "chnls" window and the APID search would walk
+ * memory that is not a mapping table. That is why this is a separate file
+ * rather than a #define change.
+ *
+ * WHAT IS SHARED
+ * The per-channel register block itself is identical in both generations
+ * (spmi-pmic-arb.c:37-43):
+ *
+ *     +0x00 CMD   +0x04 CONFIG   +0x08 STATUS
+ *     +0x10 WDATA0 +0x14 WDATA1  +0x18 RDATA0  +0x1C RDATA1
+ *
+ *     STATUS bit0 DONE, bit1 FAILURE, bit2 DENIED, bit3 DROPPED
+ *
+ * so only the addressing and the command encoding differ.
+ *
+ * READ-ONLY BY CONSTRUCTION
+ * This port only ever issues EXT_READL (opcode 1). There is no write path, no
+ * interrupt clear, and no peripheral configuration -- the same constraint
+ * sweet_spmi.c documents, kept because the PMIC also powers the CPU rails and a
+ * stray write is not recoverable from software.
+ */
+
+#ifndef SWEET_SPMI_V1_H
+#define SWEET_SPMI_V1_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Map the arbiter. Idempotent; 0 on success. */
+int sweet_spmi_v1_init(void);
+
+/*
+ * Read one byte from (sid, addr). Thread context only.
+ * 0 on success, -1 on failure; *out is untouched on failure.
+ */
+int sweet_spmi_v1_read(unsigned sid, unsigned addr, uint8_t *out);
+
+/* Which arbiter generation was found at runtime: 0 = none, 1 = v1, 5 = v5. */
+int sweet_spmi_arb_version(void);
+
+/* Human-readable one-liner for the boot log. */
+const char *sweet_spmi_arb_name(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SWEET_SPMI_V1_H */
