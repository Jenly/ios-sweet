diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..b599ca4 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,8 +273,16 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
-	cbz		w10, Ltrylock_enqueue_success
+	// casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 LL/SC equivalent of ARMv8.1 LSE casa (Kryo 280 has no LSE)
+1:	ldaxr	w12, [x3]		// exclusive load with acquire
+	cmp		w12, w10		 // old == expected (0)?
+	b.ne	2f
+	stxr		w13, w11, [x3]	// exclusive store of locked value (1)
+	cbnz		w13, 1b			// store failed, retry
+	b		3f
+2:	mov		w10, w12		 // w10 = actual old value
+3:	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
@@ -323,8 +331,16 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
-	cbz		w10, Ltrylock_dequeue_success
+	// casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 LL/SC equivalent of ARMv8.1 LSE casa (Kryo 280 has no LSE)
+1:	ldaxr	w12, [x2]		// exclusive load with acquire
+	cmp		w12, w10		 // old == expected (0)?
+	b.ne	2f
+	stxr		w13, w11, [x2]	// exclusive store of locked value (1)
+	cbnz		w13, 1b			// store failed, retry
+	b		3f
+2:	mov		w10, w12		 // w10 = actual old value
+3:	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
