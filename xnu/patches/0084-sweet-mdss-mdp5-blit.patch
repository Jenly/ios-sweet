+/*
+ * First-frame verification of the MDP5 blit.
+ *
+ * The caller has already drawn this rectangle on the CPU, so one scanline of
+ * the destination is known to be correct. Keep it, then ask the engine to
+ * reproduce exactly that scanline under each channel-selector candidate. A
+ * candidate that yields byte-identical pixels is the right encoding and gets
+ * locked in; if none does, the engine is disabled and the CPU path continues.
+ *
+ * Always restores the reference row before returning, so this cannot leave the
+ * panel showing test pixels.
+ */
+void
+AppleCLCD::free(void)
+{
+	if (fMdssRef != NULL) {
+		IOFree(fMdssRef, fMdssRefLen);
+		fMdssRef = NULL;
+		fMdssRefLen = 0;
+	}
+	IOService::free();
+}
+
+bool
+AppleCLCD::mdssVerify(uint32_t srcPhys, uint32_t srcStride, uint32_t dstPhys,
+    int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w)
+{
+	uint32_t  rowBytes = (uint32_t)w * 4u;
+	uintptr_t dstRow;
+	int32_t   tried = 0;
+
+	if (fMdssRef == NULL || w <= 0 || dx < 0 || dy < 0 ||
+	    rowBytes > fMdssRefLen) {
+		sweet_mdss_disable("no usable reference row for the first-frame check");
+		return false;
+	}
+	dstRow = fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4;
+	memcpy(fMdssRef, (const void *)dstRow, rowBytes);
+
+	for (;;) {
+		int field = sweet_mdss_dstc_candidate((uint32_t)tried);
+
+		if (field < 0) {
+			break;
+		}
+		tried++;
+		/*
+		 * Reference back, engine writes the row, compare.
+		 *
+		 * The panel is mapped write-combined, so ordering is not optional:
+		 * the CPU's stores must be visible before the engine runs, and the
+		 * engine's must have drained before the CPU reads back, or the
+		 * comparison can pass on stale bytes or fail on a race. wait_idle()
+		 * only proves the flush was consumed -- not that the writeback
+		 * reached memory -- hence the barrier and the settle delay.
+		 */
+		memcpy((void *)dstRow, fMdssRef, rowBytes);
+		__builtin_arm_dmb(DMB_ISH);
+
+		if (sweet_mdss_blit(srcPhys, srcStride, dstPhys, fRowBytes,
+		    (uint32_t)w, 1, (uint32_t)sx, (uint32_t)sy,
+		    (uint32_t)dx, (uint32_t)dy) != 0) {
+			break;
+		}
+		(void)sweet_mdss_wait_idle(0);
+		__builtin_arm_dmb(DMB_ISH);
+		IOSleep(2);
+		__builtin_arm_dmb(DMB_ISH);
+
+		if (memcmp((const void *)dstRow, fMdssRef, rowBytes) == 0) {
+			IOLog("SWEET FB: MDP5 blit verified, dstc=%#x after %d candidate(s)\n",
+			    (uint32_t)field, tried);
+			return true;
+		}
+	}
+
+	memcpy((void *)dstRow, fMdssRef, rowBytes);
+	IOLog("SWEET FB: MDP5 blit could not reproduce the pixels in %d candidate(s); "
+	    "staying on the CPU path\n", tried);
+	sweet_mdss_stats();
+	sweet_mdss_disable("first-frame comparison failed");
+	return false;
