 void sweet_crash_signal_0127(int signum, uint64_t reason);
 
+/* ---------------------------------------------------------------------------
+ * SWEET 0130: kernel-side black box for the pid-1 Mach IPC bootstrap failure.
+ *
+ * 0129 pinned the death on libpthread's _pthread_init() failing its host_info()
+ * MIG call, with guard exceptions in flight: kGUARD_EXC_INVALID_NAME for a name
+ * that is not in pid 1's space, and kGUARD_EXC_SEND_INVALID_REPLY for the reply
+ * port of that RPC.  Nothing may be printed during boot (the console ring keeps
+ * only the last ~37 lines), so record into a static ring and dump it from the
+ * pid-1 crash dump, where it survives.
+ *
+ * kind: 1 mach_reply_port           2 thread_get_special_reply_port
+ *       3 host_self_trap            4 host_info entry
+ *       5 host_info HOST_BASIC_INFO ok          6 host_info OLD_COUNT fail
+ *       7 ipc_kmsg invalid_reply    8 ipc_right INVALID_NAME
+ * ------------------------------------------------------------------------ */
+
+void sweet_bb0130(uint32_t k, uint64_t a, uint64_t b, uint64_t c, uint64_t d,
+    uint64_t e);
+void sweet_bb0130_q(uint32_t site, mach_port_name_t name);
+void sweet_bb0130_dump(const char *why);
+
+#define SWEET_BB0130_RING   128
+#define SWEET_BB0130_KINDS  12
+#define SWEET_BB0130_DUMP   10
+
+struct sweet_bb0130_ent {
+	uint64_t t;                                     /* recording task */
+	uint32_t k;                                     /* kind + 1; 0 == empty */
+	uint64_t a, b, c, d, e;
+};
+
+static struct sweet_bb0130_ent sweet_bb0130_ring[SWEET_BB0130_RING];
+static struct sweet_bb0130_ent sweet_bb0130_first[SWEET_BB0130_KINDS];
+static uint32_t sweet_bb0130_n;
+static uint32_t sweet_bb0130_cnt[SWEET_BB0130_KINDS];
+static mach_port_name_t sweet_bb0130_qname;
+static uint32_t sweet_bb0130_qsite;
+
+void
+sweet_bb0130(uint32_t k, uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t e)
+{
+	task_t t = current_task();
+	struct sweet_bb0130_ent *p;
+
+	if (k >= SWEET_BB0130_KINDS) {
+		return;
+	}
+	sweet_bb0130_cnt[k]++;
+	if (sweet_bb0130_first[k].k == 0) {
+		p = &sweet_bb0130_first[k];
+		p->k = k + 1;
+		p->t = (uint64_t)t;
+		p->a = a;
+		p->b = b;
+		p->c = c;
+		p->d = d;
+		p->e = e;
+	}
+	if (sweet_bb0130_n != 0) {
+		p = &sweet_bb0130_ring[(sweet_bb0130_n - 1) % SWEET_BB0130_RING];
+		if (p->k == k + 1 && p->t == (uint64_t)t && p->a == a && p->b == b) {
+			return;                         /* consecutive duplicate */
+		}
+	}
+	p = &sweet_bb0130_ring[sweet_bb0130_n % SWEET_BB0130_RING];
+	sweet_bb0130_n++;
+	p->k = k + 1;
+	p->t = (uint64_t)t;
+	p->a = a;
+	p->b = b;
+	p->c = c;
+	p->d = d;
+	p->e = e;
+}
+
+void
+sweet_bb0130_q(uint32_t site, mach_port_name_t name)
+{
+	sweet_bb0130_qsite = site;
+	sweet_bb0130_qname = name;
+}
+
+void
+sweet_bb0130_dump(const char *why)
+{
+	task_t t = current_task();
+	thread_t th = current_thread();
+	ipc_space_t space = (t != TASK_NULL) ? t->itk_space : IS_NULL;
+	ipc_entry_t entry = IE_NULL;
+	uint32_t cap = 0, nfree = 0, idx = 0;
+	uint32_t i, start, shown = 0, skip, j;
+
+	if (space != IS_NULL && is_active(space)) {
+		ipc_entry_table_t table = is_active_table(space);
+
+		cap = (uint32_t)ipc_entry_table_count(table);
+		nfree = (uint32_t)space->is_table_free;
+		idx = (uint32_t)MACH_PORT_INDEX(sweet_bb0130_qname);
+		if (idx != 0 && idx < cap) {
+			entry = ipc_entry_table_get(table, idx);
+		}
+	}
+
+	printf("0130 HDR %s n %u cnt", why, sweet_bb0130_n);
+	for (i = 1; i < SWEET_BB0130_KINDS; i++) {
+		printf(" %u", sweet_bb0130_cnt[i]);
+	}
+	printf("\n");
+
+	printf("0130 SP t 0x%llx sp 0x%llx own 0x%llx cap %u free %u q 0x%x site %u\n",
+	    (uint64_t)t, (uint64_t)space,
+	    (space != IS_NULL) ? (uint64_t)space->is_task : 0, cap, nfree,
+	    (uint32_t)sweet_bb0130_qname, sweet_bb0130_qsite);
+	printf("0130 QE idx %u cap %u ent %d bits 0x%x\n", idx, cap,
+	    (entry != IE_NULL) ? 1 : 0,
+	    (entry != IE_NULL) ? (uint32_t)entry->ie_bits : 0);
+	printf("0130 TH th 0x%llx srp 0x%llx\n", (uint64_t)th,
+	    (th != THREAD_NULL) ? (uint64_t)th->ith_special_reply_port : 0);
+
+	for (i = 1; i <= 8; i++) {
+		if (sweet_bb0130_first[i].k == 0) {
+			continue;
+		}
+		printf("0130 F%u t 0x%llx %llx %llx %llx %llx\n", i,
+		    sweet_bb0130_first[i].t, sweet_bb0130_first[i].a,
+		    sweet_bb0130_first[i].b, sweet_bb0130_first[i].c,
+		    sweet_bb0130_first[i].d);
+	}
+
+	start = (sweet_bb0130_n > SWEET_BB0130_RING) ?
+	    (sweet_bb0130_n - SWEET_BB0130_RING) : 0;
+	for (i = start; i < sweet_bb0130_n; i++) {
+		if (sweet_bb0130_ring[i % SWEET_BB0130_RING].k != 0) {
+			shown++;
+		}
+	}
+	skip = (shown > SWEET_BB0130_DUMP) ? (shown - SWEET_BB0130_DUMP) : 0;
+	j = 0;
+	for (i = start; i < sweet_bb0130_n; i++) {
+		struct sweet_bb0130_ent *p = &sweet_bb0130_ring[i % SWEET_BB0130_RING];
+
+		if (p->k == 0) {
+			continue;
+		}
+		if (j++ < skip) {
+			continue;
+		}
+		printf("0130 E%u t 0x%llx %llx %llx %llx %llx\n", p->k, p->t,
+		    p->a, p->b, p->c, p->d);
+	}
+}
